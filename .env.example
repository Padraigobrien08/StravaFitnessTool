# =============================================================================
# StrideIQ — copy to .env.local (never commit .env.local)
# =============================================================================
#
# NONE OF THIS IS REQUIRED TO TRY THE APP. "Try the demo" (sample athlete) and
# local Strava-export import both run 100% in the browser — no vars, no DB, no
# API key. Only set the variables below for live Strava sync, Coach, or MCP.
#
# MINIMUM FOR LOCAL DEV (export CSV only):
#   Leave this file empty or unset — no server vars required.
#
# MINIMUM FOR STRAVA OAUTH + COACH:
#   DATABASE_URL, SESSION_SECRET, STRAVA_CLIENT_ID, STRAVA_CLIENT_SECRET,
#   STRAVA_REDIRECT_URI, OPENAI_API_KEY (or ANTHROPIC_API_KEY)
#
# See docs/DEPLOYMENT.md for production (Vercel + Neon + Strava callback URLs).
# =============================================================================

# --- Strava OAuth (https://www.strava.com/settings/api) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Local: http://localhost:3000/api/auth/strava/callback
# Prod:  https://YOUR_DOMAIN/api/auth/strava/callback
STRAVA_REDIRECT_URI=http://localhost:3000/api/auth/strava/callback

# --- Strava webhooks (optional auto-sync) ---
# Random string; must match Strava subscription verify token
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Public HTTPS URL ending with /api/webhooks/strava
# Local dev: ngrok http 3000 → https://xxxx.ngrok-free.app/api/webhooks/strava
STRAVA_WEBHOOK_CALLBACK_URL=

# --- Database (Neon Postgres — required for OAuth / Coach / sync) ---
# https://console.neon.tech — use pooled connection string
DATABASE_URL=

# --- Session (required when DATABASE_URL is set) ---
# Generate: openssl rand -hex 32
SESSION_SECRET=

# --- LLM — Coach chat + AI weekly plan (at least one provider for Coach) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WEEKLY_PLAN_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- MCP / automation (optional — maps API key to Neon user id) ---
STRIDEIQ_API_KEY=
STRIDEIQ_API_KEY_USER_ID=

# --- Optional ---
# NEON_PROJECT_ID=
# Expose /dev/forecast-lab in production (default: dev only)
# NEXT_PUBLIC_FORECAST_LAB=1
